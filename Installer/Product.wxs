<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
    <Product Id="*"
             Name="ValorVDC Family Browser"
             Language="1033"
             Version="$(var.ProductVersion)"
             Manufacturer="ValorVDC"
             UpgradeCode="3B4C5D6E-F7A8-4B9C-0D1E-2F3A4B5C6D7E">

        <Package InstallerVersion="200"
                 Compressed="yes"
                 InstallScope="perMachine"
                 Description="ValorVDC Family Browser v$(var.ProductVersion)" />

        <MajorUpgrade
            AllowSameVersionUpgrades="yes"
            DowngradeErrorMessage="A newer version of [ProductName] is already installed." />

        <MediaTemplate EmbedCab="yes" />

        <!--
            To show a product icon in Add/Remove Programs, add a Logo-32x32.ico to Resources\
            and uncomment these two lines:
            <Icon Id="ProductIcon" SourceFile="..\Resources\Logo-32x32.ico" />
            <Property Id="ARPPRODUCTICON" Value="ProductIcon" />
        -->
        <Property Id="ARPURLINFOABOUT" Value="https://www.valorvdc.com/" />

        <WixVariable Id="WixUILicenseRtf" Value="License.rtf" />

        <Feature Id="ProductFeature" Title="ValorVDC Family Browser" Level="1">
            <ComponentGroupRef Id="RevitAddinComponents" />
            <ComponentGroupRef Id="ShortcutComponents" />
        </Feature>

        <UIRef Id="WixUI_Minimal" />

    </Product>

    <Fragment>
        <Directory Id="TARGETDIR" Name="SourceDir">

            <!--
                Installs to C:\ProgramData\Autodesk\Revit\Addins\<year>\
                .addin files go in the root of each year folder (Revit only scans the root).
                DLLs go in a ValorVDC_FamilyBrowser subfolder referenced by absolute path.
            -->
            <Directory Id="CommonAppDataFolder">
                <Directory Id="AutodeskCommonFolder" Name="Autodesk">
                    <Directory Id="RevitCommonFolder" Name="Revit">
                        <Directory Id="RevitAddinsFolder" Name="Addins">

                            <Directory Id="RevitAddins2024" Name="2024">
                                <Directory Id="RevitAddinsSubDir2024" Name="ValorVDC_FamilyBrowser" />
                            </Directory>

                            <Directory Id="RevitAddins2025" Name="2025">
                                <Directory Id="RevitAddinsSubDir2025" Name="ValorVDC_FamilyBrowser" />
                            </Directory>

                            <Directory Id="RevitAddins2026" Name="2026">
                                <Directory Id="RevitAddinsSubDir2026" Name="ValorVDC_FamilyBrowser" />
                            </Directory>

                            <Directory Id="RevitAddins2027" Name="2027">
                                <Directory Id="RevitAddinsSubDir2027" Name="ValorVDC_FamilyBrowser" />
                            </Directory>

                        </Directory>
                    </Directory>
                </Directory>
            </Directory>

            <!-- Start Menu shortcut for uninstall -->
            <Directory Id="ProgramMenuFolder">
                <Directory Id="ApplicationProgramsFolder" Name="ValorVDC Family Browser" />
            </Directory>

        </Directory>
    </Fragment>

    <Fragment>
        <ComponentGroup Id="RevitAddinComponents">

            <!-- ── Revit 2024 (net48) ── -->
            <Component Id="Addin2024" Directory="RevitAddins2024"
                       Guid="2B3C4D5E-F6A7-4B8C-9D0E-1F2A3B4C5D6E">
                <File Id="Addin2024File"
                      Source="AddinFiles\ValorVDC_FamilyBrowser_2024.addin"
                      Name="ValorVDC_FamilyBrowser.addin"
                      KeyPath="yes" />
            </Component>
            <Component Id="DLL2024" Directory="RevitAddinsSubDir2024"
                       Guid="3C4D5E6F-A7B8-4C9D-0E1F-2A3B4C5D6E7F">
                <File Id="DLL2024File"
                      Source="..\bin\Release R24\ValorVDC_FamilyBrowser.dll"
                      KeyPath="yes" />
                <RemoveFolder Id="RemoveSubDir2024" Directory="RevitAddinsSubDir2024" On="uninstall" />
            </Component>

            <!-- ── Revit 2025 (net8.0-windows) ── -->
            <Component Id="Addin2025" Directory="RevitAddins2025"
                       Guid="4D5E6F7A-B8C9-4D0E-1F2A-3B4C5D6E7F8A">
                <File Id="Addin2025File"
                      Source="AddinFiles\ValorVDC_FamilyBrowser_2025.addin"
                      Name="ValorVDC_FamilyBrowser.addin"
                      KeyPath="yes" />
            </Component>
            <Component Id="DLL2025" Directory="RevitAddinsSubDir2025"
                       Guid="5E6F7A8B-C9D0-4E1F-2A3B-4C5D6E7F8A9B">
                <File Id="DLL2025File"
                      Source="..\bin\Release R25\ValorVDC_FamilyBrowser.dll"
                      KeyPath="yes" />
                <RemoveFolder Id="RemoveSubDir2025" Directory="RevitAddinsSubDir2025" On="uninstall" />
            </Component>

            <!-- ── Revit 2026 (net8.0-windows) ── -->
            <Component Id="Addin2026" Directory="RevitAddins2026"
                       Guid="6F7A8B9C-D0E1-4F2A-3B4C-5D6E7F8A9B0C">
                <File Id="Addin2026File"
                      Source="AddinFiles\ValorVDC_FamilyBrowser_2026.addin"
                      Name="ValorVDC_FamilyBrowser.addin"
                      KeyPath="yes" />
            </Component>
            <Component Id="DLL2026" Directory="RevitAddinsSubDir2026"
                       Guid="7A8B9C0D-E1F2-4A3B-4C5D-6E7F8A9B0C1D">
                <File Id="DLL2026File"
                      Source="..\bin\Release R26\ValorVDC_FamilyBrowser.dll"
                      KeyPath="yes" />
                <RemoveFolder Id="RemoveSubDir2026" Directory="RevitAddinsSubDir2026" On="uninstall" />
            </Component>

            <!-- ── Revit 2027 (net10.0-windows) ── -->
            <Component Id="Addin2027" Directory="RevitAddins2027"
                       Guid="8B9C0D1E-F2A3-4B4C-5D6E-7F8A9B0C1D2E">
                <File Id="Addin2027File"
                      Source="AddinFiles\ValorVDC_FamilyBrowser_2027.addin"
                      Name="ValorVDC_FamilyBrowser.addin"
                      KeyPath="yes" />
            </Component>
            <Component Id="DLL2027" Directory="RevitAddinsSubDir2027"
                       Guid="9C0D1E2F-A3B4-4C5D-6E7F-8A9B0C1D2E3F">
                <File Id="DLL2027File"
                      Source="..\bin\Release R27\ValorVDC_FamilyBrowser.dll"
                      KeyPath="yes" />
                <RemoveFolder Id="RemoveSubDir2027" Directory="RevitAddinsSubDir2027" On="uninstall" />
            </Component>

        </ComponentGroup>

        <!-- Uninstall shortcut in Start Menu -->
        <ComponentGroup Id="ShortcutComponents">
            <Component Id="UninstallShortcut" Directory="ApplicationProgramsFolder"
                       Guid="0D1E2F3A-B4C5-4D6E-7F8A-9B0C1D2E3F4A">
                <Shortcut Id="UninstallProduct"
                          Name="Uninstall ValorVDC Family Browser"
                          Description="Uninstalls ValorVDC Family Browser"
                          Target="[SystemFolder]msiexec.exe"
                          Arguments="/x [ProductCode]" />
                <RemoveFolder Id="ApplicationProgramsFolder" On="uninstall" />
                <RegistryValue Root="HKCU"
                               Key="Software\ValorVDC\FamilyBrowser"
                               Name="installed"
                               Type="integer"
                               Value="1"
                               KeyPath="yes" />
            </Component>
        </ComponentGroup>
    </Fragment>

</Wix>
