<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
    <Product Id="*"
             Name="ValorVDC Family Browser"
             Language="1033"
             Version="$(var.ProductVersion)"
             Manufacturer="ValorVDC"
             UpgradeCode="3B4C5D6E-F7A8-4B9C-0D1E-2F3A4B5C6D7E">

        <Package InstallerVersion="200"
                 Compressed="yes"
                 InstallScope="perMachine"
                 Description="ValorVDC Family Browser v$(var.ProductVersion)" />

        <MajorUpgrade
            AllowSameVersionUpgrades="yes"
            DowngradeErrorMessage="A newer version of [ProductName] is already installed." />

        <MediaTemplate EmbedCab="yes" />

        <Property Id="ARPURLINFOABOUT" Value="https://www.valorvdc.com/" />

        <WixVariable Id="WixUILicenseRtf" Value="License.rtf" />

        <Feature Id="ProductFeature" Title="ValorVDC Family Browser" Level="1">
            <ComponentGroupRef Id="BundleComponents" />
            <ComponentGroupRef Id="ShortcutComponents" />
        </Feature>

        <UIRef Id="WixUI_Minimal" />

    </Product>

    <Fragment>
        <Directory Id="TARGETDIR" Name="SourceDir">

            <!--
                Installs to C:\ProgramData\Autodesk\ApplicationPlugins\ValorVDC_FamilyBrowser.bundle\
                This is the Autodesk App Store-required bundle format.
                PackageContents.xml tells Revit which addin to load per version.
                Each Contents\<year>\ folder holds the addin file + DLL.
                The addin file uses a relative Assembly path (just the DLL filename)
                so Revit resolves it relative to the addin file's directory.
            -->
            <Directory Id="CommonAppDataFolder">
                <Directory Id="AutodeskCommonFolder" Name="Autodesk">
                    <Directory Id="ApplicationPluginsFolder" Name="ApplicationPlugins">
                        <Directory Id="BundleFolder" Name="ValorVDC_FamilyBrowser.bundle">
                            <Directory Id="ContentsFolder" Name="Contents">
                                <Directory Id="Contents2024" Name="2024" />
                                <Directory Id="Contents2025" Name="2025" />
                                <Directory Id="Contents2026" Name="2026" />
                                <Directory Id="Contents2027" Name="2027" />
                            </Directory>
                        </Directory>
                    </Directory>
                </Directory>
            </Directory>

            <!-- Start Menu shortcut for uninstall -->
            <Directory Id="ProgramMenuFolder">
                <Directory Id="ApplicationProgramsFolder" Name="ValorVDC Family Browser" />
            </Directory>

        </Directory>
    </Fragment>

    <Fragment>
        <ComponentGroup Id="BundleComponents">

            <!-- PackageContents.xml at bundle root — Revit reads this to find the addins -->
            <Component Id="PackageContentsComp" Directory="BundleFolder"
                       Guid="F7A8B9C0-D1E2-4F3A-B4C5-D6E7F8091A2B">
                <File Id="PackageContentsFile"
                      Source="PackageContents.xml"
                      KeyPath="yes" />
                <RemoveFolder Id="RemoveBundleFolder"   Directory="BundleFolder"   On="uninstall" />
                <RemoveFolder Id="RemoveContentsFolder" Directory="ContentsFolder" On="uninstall" />
            </Component>

            <!-- ── Revit 2024 (net48) ── -->
            <Component Id="Addin2024" Directory="Contents2024"
                       Guid="C0D1E2F3-A4B5-4C6D-7E8F-9A0B1C2D3E4F">
                <File Id="Addin2024File"
                      Source="AddinFiles\ValorVDC_FamilyBrowser_2024.addin"
                      Name="ValorVDC_FamilyBrowser.addin"
                      KeyPath="yes" />
            </Component>
            <Component Id="DLL2024" Directory="Contents2024"
                       Guid="D1E2F3A4-B5C6-4D7E-8F9A-0B1C2D3E4F5A">
                <File Id="DLL2024File"
                      Source="..\bin\Release R24\ValorVDC_FamilyBrowser.dll"
                      KeyPath="yes" />
                <RemoveFolder Id="RemoveContents2024" Directory="Contents2024" On="uninstall" />
            </Component>

            <!-- ── Revit 2025 (net8.0-windows) ── -->
            <Component Id="Addin2025" Directory="Contents2025"
                       Guid="E2F3A4B5-C6D7-4E8F-9A0B-1C2D3E4F5A6B">
                <File Id="Addin2025File"
                      Source="AddinFiles\ValorVDC_FamilyBrowser_2025.addin"
                      Name="ValorVDC_FamilyBrowser.addin"
                      KeyPath="yes" />
            </Component>
            <Component Id="DLL2025" Directory="Contents2025"
                       Guid="F3A4B5C6-D7E8-4F9A-0B1C-2D3E4F5A6B7C">
                <File Id="DLL2025File"
                      Source="..\bin\Release R25\ValorVDC_FamilyBrowser.dll"
                      KeyPath="yes" />
                <RemoveFolder Id="RemoveContents2025" Directory="Contents2025" On="uninstall" />
            </Component>

            <!-- ── Revit 2026 (net8.0-windows) ── -->
            <Component Id="Addin2026" Directory="Contents2026"
                       Guid="A4B5C6D7-E8F9-4A0B-1C2D-3E4F5A6B7C8D">
                <File Id="Addin2026File"
                      Source="AddinFiles\ValorVDC_FamilyBrowser_2026.addin"
                      Name="ValorVDC_FamilyBrowser.addin"
                      KeyPath="yes" />
            </Component>
            <Component Id="DLL2026" Directory="Contents2026"
                       Guid="B5C6D7E8-F9A0-4B1C-2D3E-4F5A6B7C8D9E">
                <File Id="DLL2026File"
                      Source="..\bin\Release R26\ValorVDC_FamilyBrowser.dll"
                      KeyPath="yes" />
                <RemoveFolder Id="RemoveContents2026" Directory="Contents2026" On="uninstall" />
            </Component>

            <!-- ── Revit 2027 (net10.0-windows) ── -->
            <Component Id="Addin2027" Directory="Contents2027"
                       Guid="C6D7E8F9-A0B1-4C2D-3E4F-5A6B7C8D9E0F">
                <File Id="Addin2027File"
                      Source="AddinFiles\ValorVDC_FamilyBrowser_2027.addin"
                      Name="ValorVDC_FamilyBrowser.addin"
                      KeyPath="yes" />
            </Component>
            <Component Id="DLL2027" Directory="Contents2027"
                       Guid="D7E8F9A0-B1C2-4D3E-4F5A-6B7C8D9E0F1A">
                <File Id="DLL2027File"
                      Source="..\bin\Release R27\ValorVDC_FamilyBrowser.dll"
                      KeyPath="yes" />
                <RemoveFolder Id="RemoveContents2027" Directory="Contents2027" On="uninstall" />
            </Component>

        </ComponentGroup>

        <!-- Uninstall shortcut in Start Menu -->
        <ComponentGroup Id="ShortcutComponents">
            <Component Id="UninstallShortcut" Directory="ApplicationProgramsFolder"
                       Guid="E8F9A0B1-C2D3-4E4F-5A6B-7C8D9E0F1A2B">
                <Shortcut Id="UninstallProduct"
                          Name="Uninstall ValorVDC Family Browser"
                          Description="Uninstalls ValorVDC Family Browser"
                          Target="[SystemFolder]msiexec.exe"
                          Arguments="/x [ProductCode]" />
                <RemoveFolder Id="ApplicationProgramsFolder" On="uninstall" />
                <RegistryValue Root="HKCU"
                               Key="Software\ValorVDC\FamilyBrowser"
                               Name="installed"
                               Type="integer"
                               Value="1"
                               KeyPath="yes" />
            </Component>
        </ComponentGroup>
    </Fragment>

</Wix>
